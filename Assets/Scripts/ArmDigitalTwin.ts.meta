  InputLines:
    - '// @input AssignableType teleop {"hint":"The ArmRelayClient component: the twin sends through its relay connection."}'
    - '// @input Asset.RenderMesh[] linkMeshes {"hint":"The 7 imported link meshes in order: link0 (base) ... link6 (flange), from ModelImport/link0.glb ... link6.glb."}'
    - '// @input Asset.Material armMaterial {"hint":"Material for the model (e.g. a grey PBR or Unlit material)."}'
    - '// @input Asset.Material[] linkMaterials = {} {"hint":"Optional per-part materials, same order as Link Meshes (element 0 = link0, the base ... 6 = the flange). An empty slot, or a shorter list, uses Arm Material for that part."}'
    - '// @input Asset.Material ghostMaterial {"hint":"Optional see-through material for the ghost that shows where you are dragging the arm. Leave empty for no ghost."}'
    - "// @input Asset.Material outlineMaterial {\"hint\":\"Optional: SIK's outline material (Packages > SpectaclesInteractionKit > Assets > Materials > TargetOutlineMaterial). Outlines the part your hand is on, like Snap's own InteractableOutlineFeedback.\"}"
    - "// @input vec4 hoverColor = \"{1, 1, 0.04, 1}\" {\"hint\":\"Outline colour while a hand hovers a part (SIK's default yellow).\", \"widget\":\"color\"}"
    - "// @input vec4 grabColor = \"{1, 1, 1, 1}\" {\"hint\":\"Outline colour while a part is pinched (SIK's default white).\", \"widget\":\"color\"}"
    - "// @input float outlineWeight = 0.25 {\"hint\":\"Outline thickness in cm (SIK's default 0.25). Change it if the outline looks too thick or thin.\"}"
    - '// @input Asset.Material hoverMaterial {"hint":"Optional: a material the hovered / pinched part switches to (e.g. a brighter copy of the Arm Material). Can be used with or without the outline."}'
    - '// @input float modelScale = 0.4 {"hint":"Model size relative to the real arm (0.4 = 40%). Bigger = easier to grab small parts."}'
    - "// @input float tcpYawDeg = 90 {\"hint\":\"Must equal the yaw in the station's aubo.tcp_offset (config/arm_bridge.yaml): 90.\"}"
    - '// @input float spawnDistanceCm = 55 {"hint":"Where the model appears when shown: distance in front of you (cm)."}'
    - '// @input float spawnHeightCm = -40 {"hint":"Where the model appears when shown: height of its base relative to your eyes (cm, negative = below)."}'
    - '// @input Component.Text twinText {"hint":"Optional Text for twin hints and status."}'
